#!/bin/bash

# omagtk: a GTK3 theme that follows the current Omarchy theme.
#
# The theme's CSS is shared (installed by the package), but its colors are per
# user, so each user gets a small theme folder in ~/.local/share/themes/Omagtk:
# links to the shared CSS plus a colors.css generated from their Omarchy theme.

set -euo pipefail

VERSION="0.1.0"
THEME_NAME="Omagtk"
THEME_DIR="${OMAGTK_THEME_DIR:-$HOME/.local/share/themes/$THEME_NAME}"
COLORS_TOML="${OMAGTK_COLORS_TOML:-$HOME/.local/state/omarchy/current/theme/colors.toml}"
HOOK_PATH="$HOME/.config/omarchy/hooks/theme-set.d/omagtk"
SCHEMA="org.gnome.desktop.interface"

usage() {
  cat <<EOF
Usage: omagtk <command>

A GTK3 theme that follows your Omarchy theme.

Commands:
  setup            Set up Omagtk for this user: theme folder, Omarchy hook,
                   and activate it
  apply            Regenerate colors from the current Omarchy theme and reload
                   running GTK3 apps (what the hook runs on theme changes)
  apply --colors   Only regenerate colors, without touching GTK settings
  watch            Keep GTK3 apps on Omagtk while Omarchy changes themes,
                   instead of showing Adwaita until the hook runs
  remove           Undo setup for this user and switch GTK back to Adwaita
  status           Show whether Omagtk is set up and active
  version          Print the version

Environment:
  OMAGTK_COLORS_TOML   palette to use instead of the current Omarchy theme
EOF
}

fail() {
  echo "omagtk: $*" >&2
  exit 1
}

# Where the shared theme files live: a source checkout (when run from one),
# a per-user install from install.sh, or the system package.
data_dir() {
  local self candidate
  self=$(readlink -f "${BASH_SOURCE[0]}")

  for candidate in \
    "${OMAGTK_DATA_DIR:-}" \
    "$(dirname "$self")/.." \
    "$HOME/.local/share/omagtk" \
    "/usr/share/omagtk"; do
    if [[ -n $candidate && -f $candidate/theme/gtk-3.0/gtk.css ]]; then
      readlink -f "$candidate"
      return
    fi
  done

  fail "theme files not found; is omagtk installed?"
}

has_session() {
  [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] && command -v gsettings >/dev/null
}

# (Re)build the user's theme folder: links to the shared CSS, so package
# upgrades take effect without running setup again. colors.css is kept.
link_theme() {
  local data="$1" file

  # An older install may have made the whole folder a symlink.
  [[ -L $THEME_DIR ]] && rm "$THEME_DIR"
  mkdir -p "$THEME_DIR/gtk-3.0"

  ln -sfn "$data/theme/index.theme" "$THEME_DIR/index.theme"
  for file in gtk.css gtk-dark.css; do
    ln -sfn "$data/theme/gtk-3.0/$file" "$THEME_DIR/gtk-3.0/$file"
  done
}

write_colors() {
  local out="$THEME_DIR/gtk-3.0/colors.css"

  # Tokyo Night, used when no Omarchy palette is available.
  declare -A C=(
    [mode]=dark
    [background]="#1a1b26"
    [foreground]="#a9b1d6"
    [accent]="#7aa2f7"
    [red]="#f7768e"
    [green]="#9ece6a"
    [yellow]="#e0af68"
    [blue]="#7aa2f7"
    [magenta]="#bb9af7"
    [cyan]="#7dcfff"
  )

  if [[ -f $COLORS_TOML ]] && command -v omarchy-theme-color >/dev/null; then
    local key value
    while IFS=$'\t' read -r key value; do
      C[$key]="$value"
    done < <(omarchy-theme-color --file "$COLORS_TOML" --all)
  fi

  local key
  for key in background foreground accent red green yellow blue magenta cyan; do
    [[ ${C[$key]} =~ ^#[0-9A-Fa-f]{6}$ ]] || fail "bad color '$key' = '${C[$key]}' in $COLORS_TOML"
  done

  # WCAG contrast ratio between two hex colors.
  contrast() {
    awk -v a="${1#\#}" -v b="${2#\#}" '
      function ch(v) { v /= 255; return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ^ 2.4 }
      function lum(h) {
        return 0.2126 * ch(strtonum("0x" substr(h, 1, 2))) \
             + 0.7152 * ch(strtonum("0x" substr(h, 3, 2))) \
             + 0.0722 * ch(strtonum("0x" substr(h, 5, 2)))
      }
      BEGIN {
        la = lum(a); lb = lum(b)
        if (la < lb) { t = la; la = lb; lb = t }
        printf "%.3f\n", (la + 0.05) / (lb + 0.05)
      }'
  }

  # Text color to put on top of a filled surface: the theme's own background
  # or foreground when either reads well, otherwise plain white or black.
  on_color() {
    local surface="$1" best="" best_ratio=0 candidate ratio

    for candidate in "${C[background]}" "${C[foreground]}" "#ffffff" "#000000"; do
      ratio=$(contrast "$surface" "$candidate")
      # Prefer the theme's own colors when they are readable.
      if [[ $candidate == "#ffffff" || $candidate == "#000000" ]]; then
        awk -v r="$best_ratio" 'BEGIN { exit !(r >= 4.5) }' && continue
      fi
      if awk -v r="$ratio" -v b="$best_ratio" 'BEGIN { exit !(r > b) }'; then
        best="$candidate"
        best_ratio="$ratio"
      fi
    done

    printf "%s" "$best"
  }

  local extreme knob shadow_strength
  if [[ ${C[mode]} == "light" ]]; then
    extreme="#ffffff"
    knob="#ffffff"
    shadow_strength="0.12"
  else
    extreme="#000000"
    knob=$(awk -v f="${C[foreground]#\#}" 'BEGIN {
      for (i = 1; i <= 5; i += 2) printf (i == 1 ? "#" : "") "%02x", int(strtonum("0x" substr(f, i, 2)) * 0.35 + 255 * 0.65 + 0.5)
    }')
    shadow_strength="0.35"
  fi

  local tmp
  tmp=$(mktemp "$out.XXXXXX")
  cat >"$tmp" <<EOF
/* Generated by omagtk from ${COLORS_TOML/#$HOME/\~}. Do not edit. */

@define-color omg_bg ${C[background]};
@define-color omg_fg ${C[foreground]};
@define-color omg_accent ${C[accent]};
@define-color omg_accent_fg $(on_color "${C[accent]}");

@define-color omg_red ${C[red]};
@define-color omg_red_fg $(on_color "${C[red]}");
@define-color omg_green ${C[green]};
@define-color omg_green_fg $(on_color "${C[green]}");
@define-color omg_yellow ${C[yellow]};
@define-color omg_yellow_fg $(on_color "${C[yellow]}");
@define-color omg_blue ${C[blue]};
@define-color omg_magenta ${C[magenta]};
@define-color omg_cyan ${C[cyan]};

/* $([[ ${C[mode]} == light ]] && echo light || echo dark) mode */
@define-color omg_extreme $extreme;
@define-color omg_knob $knob;
@define-color omg_shadow alpha(black, $shadow_strength);
EOF
  chmod 644 "$tmp"
  mv "$tmp" "$out"
}

# A fingerprint of the theme files GTK would load, so activate can tell whether
# running apps already show exactly these files.
theme_stamp() {
  cat "$THEME_DIR/index.theme" "$THEME_DIR"/gtk-3.0/*.css 2>/dev/null | cksum
}

# GTK only rereads theme CSS when the theme name changes, so bounce through
# another theme when Omagtk is already active, unless nothing has changed
# since the last time it was activated.
activate() {
  has_session || return 0

  local stamp_file="$THEME_DIR/.applied" stamp
  stamp=$(theme_stamp)

  if [[ $(gsettings get $SCHEMA gtk-theme) == "'$THEME_NAME'" ]]; then
    [[ -f $stamp_file && $(<"$stamp_file") == "$stamp" ]] && return 0
    gsettings set $SCHEMA gtk-theme "Adwaita"
    sleep 0.3
  fi
  gsettings set $SCHEMA gtk-theme "$THEME_NAME"
  echo "$stamp" >"$stamp_file"
}

cmd_apply() {
  link_theme "$(data_dir)"
  write_colors
  [[ ${1:-} == "--colors" ]] || activate
}

cmd_setup() {
  local data hook_source
  data=$(data_dir)
  hook_source="$data/hooks/omagtk"

  cmd_apply

  # Replace rather than overwrite: an older install may have linked the hook
  # to a checkout, and copying onto that link would write through it.
  rm -f "$HOOK_PATH"
  if command -v omarchy-hook-install >/dev/null; then
    omarchy-hook-install theme-set "$hook_source" >/dev/null
  else
    mkdir -p "$(dirname "$HOOK_PATH")"
    install -m 755 "$hook_source" "$HOOK_PATH"
  fi

  echo "Omagtk is set up and active. It will follow every Omarchy theme change."
}

cmd_remove() {
  rm -f "$HOOK_PATH"
  rm -rf "$THEME_DIR"

  if has_session && [[ $(gsettings get $SCHEMA gtk-theme) == "'$THEME_NAME'" ]]; then
    if command -v omarchy-theme-set-gnome >/dev/null; then
      omarchy-theme-set-gnome
    else
      gsettings set $SCHEMA gtk-theme "Adwaita"
    fi
  fi

  echo "Omagtk removed for this user."
}

# On a theme change, Omarchy switches GTK to Adwaita and only runs the
# theme-set hook after all its other theme commands finish, so GTK apps show
# Adwaita for a second or more. Watch the setting and switch straight back.
# Runs until killed; the Omarchy plugin keeps it running.
cmd_watch() {
  has_session || fail "watch needs a desktop session with gsettings"

  local theme_name_file="$HOME/.local/state/omarchy/current/theme.name"
  local monitor monitor_pid key value

  exec {monitor}< <(exec gsettings monitor $SCHEMA gtk-theme)
  monitor_pid=$!
  trap 'kill "$monitor_pid" 2>/dev/null' EXIT
  trap 'exit 0' TERM INT HUP

  while read -r -u "$monitor" key value; do
    [[ $value == "'Adwaita'" || $value == "'Adwaita-dark'" ]] || continue
    # Omagtk was removed.
    [[ -d $THEME_DIR/gtk-3.0 ]] || continue
    # Only during a theme change, so choosing Adwaita yourself still sticks.
    [[ -f $theme_name_file ]] || continue
    ((EPOCHSECONDS - $(stat -c %Y "$theme_name_file") <= 30)) || continue

    # The plugin usually has the colors ready by now. GTK shows Adwaita until
    # the next line, so flip the setting first and record the stamp after.
    [[ $THEME_DIR/gtk-3.0/colors.css -nt $COLORS_TOML ]] || write_colors
    gsettings set $SCHEMA gtk-theme "$THEME_NAME"
    theme_stamp >"$THEME_DIR/.applied"
  done
}

cmd_status() {
  local active="unknown"
  has_session && active=$(gsettings get $SCHEMA gtk-theme)

  echo "Version:     $VERSION"
  echo "Theme files: $(data_dir 2>/dev/null || echo missing)"
  echo "Theme:       $([[ -f $THEME_DIR/gtk-3.0/colors.css ]] && echo "$THEME_DIR" || echo "not set up")"
  echo "Hook:        $([[ -f $HOOK_PATH ]] && echo "$HOOK_PATH" || echo "not installed")"
  echo "GTK theme:   $active"
}

case "${1:-}" in
  setup) cmd_setup ;;
  apply) cmd_apply "${2:-}" ;;
  remove) cmd_remove ;;
  watch) cmd_watch ;;
  status) cmd_status ;;
  version | --version | -V) echo "omagtk $VERSION" ;;
  help | --help | -h) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
